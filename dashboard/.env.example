VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEVICE_ID=greenhouse-01

# Chỉ dùng khi Backend demo trên LAN bật X-API-Key.
# Biến VITE_* được bundle vào frontend và không phải secret mạnh.
VITE_API_KEY=

# A5.2: default OFF. Use /?preview=secure to try authenticated Dashboard.
# A6: enable only after strict Backend + Dashboard checks pass.
VITE_AUTH_GATE_ENABLED=0
