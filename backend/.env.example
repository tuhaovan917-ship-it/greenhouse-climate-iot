# Copy to .env and adjust. Never commit the real .env.
# (database/README.md v0.2 section 4: only .env.example belongs in Git.)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
DEVICE_ID=greenhouse-01
# Leave empty for localhost demo. Set a value to require X-API-Key on
# POST /api/commands and POST /api/config when running on the LAN.
API_KEY=

# --- MQTT (Eclipse Mosquitto, see docker-compose.yml) ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=greenhouse-backend
MQTT_KEEPALIVE_S=30
MQTT_ENABLED=1
# TLS example: MQTT_URL=mqtts://broker.example.com:8883 + MQTT_CA_FILE=./certs/ca.crt
MQTT_CA_FILE=

# --- Timeouts (docs/api-contract.md v0.2.2 sections 3.4 and 3.5) ---
# No ESP32 reply within this many seconds -> command becomes TIMEOUT.
COMMAND_TIMEOUT_S=5
# No valid MQTT message for this many seconds -> device online=false.
DEVICE_TIMEOUT_S=15

# --- Database ---
# SQLite demo (WAL is enabled automatically).
DATABASE_URL=sqlite:///./greenhouse.db
# PostgreSQL upgrade path (no real credentials in Git):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/greenhouse

# --- Guards ---
# Max raw rows scanned by one history query before bucket aggregation.
# ESP32 publishes every 2s -> ~43k rows per 24h, so keep this above that value.
# Wider ranges must use bucket=1m|5m|1h instead of raw.
MAX_SCAN_ROWS=50000
# In-memory recent telemetry cache size for /telemetry/latest fallback.
TELEMETRY_CACHE_SIZE=500
# Dev/demo only: create missing tables at startup so a fresh clone runs without
# Alembic. Keep 0 and use `alembic upgrade head` from database/ (Member 3).
AUTO_CREATE_TABLES=0

# --- User authentication (A3) ---
# False ONLY for localhost/http development. Must be True behind HTTPS.
AUTH_COOKIE_SECURE=0
AUTH_SESSION_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A4.2: leave 0 until Dashboard login, CSRF and WebSocket auth are ready.
AUTH_ENFORCEMENT_ENABLED=0
