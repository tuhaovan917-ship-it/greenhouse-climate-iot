# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets - only .env.example is committed (CONTRIBUTING.md rule 5)
.env

# Runtime SQLite database (WAL mode also creates -wal and -shm files)
*.db
*.db-wal
*.db-shm

# TLS certificates must never be committed
certs/

# Test / coverage output
.pytest_cache/
.coverage
htmlcov/
*.log

# Local verification only - not part of the deliverable.
# These pytest suites and check scripts are kept on the developer's machine to
# verify the Backend against docs/api-contract.md before opening a Pull Request.
tests/
scripts/
pytest.ini
